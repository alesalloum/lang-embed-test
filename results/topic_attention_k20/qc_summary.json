      },
      {
        "post_id": "ai_coding_innovations_050",
        "cosine": 0.8036244623544493,
        "topic": "ai_coding_innovations",
        "language": "en",
        "text": "Cautious optimism: AI coding tools amplify careful engineers. They also amplify messy habits. Discipline still wins."
      },
      {
        "post_id": "ai_coding_innovations_014",
        "cosine": 0.7916756419091191,
        "topic": "ai_coding_innovations",
        "language": "en",
        "text": "The best coding AIs aren't the ones that write the most code — they're the ones that ask clarifying questions first."
      },
      {
        "post_id": "ai_coding_innovations_050",
        "cosine": 0.7891862537569241,
        "topic": "ai_coding_innovations",
        "language": "zh",
        "text": "谨慎乐观：人工智能编码工具增强了细心的工程师的能力。它们还会加剧杂乱的习惯。纪律仍然获胜。"
      },
      {
        "post_id": "ai_coding_innovations_041",
        "cosine": 0.7814127905613174,
        "topic": "ai_coding_innovations",
        "language": "en",
        "text": "Teaching the intern: use AI for boilerplate, use your brain for invariants. That rule is sticking."
      }
    ],
